# Copy to .env.local and fill in (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Shown on the printed certificate
NEXT_PUBLIC_AUTHORITY_NAME=Vehicle Fitness Inspection Authority
NEXT_PUBLIC_AUTHORITY_SUBTITLE=Government of Pakistan
NEXT_PUBLIC_CERT_VALIDITY_MONTHS=12
